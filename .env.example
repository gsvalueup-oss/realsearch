# 앱 설정
APP_NAME=RealSearch
DEBUG=False

# 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/realsearch

# API 서버
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# CORS 설정 (프론트엔드 URL)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 데이터 수집
DATA_FETCH_INTERVAL_HOURS=24
VWORLD_API_KEY=your_api_key_here

# CSV 데이터 디렉토리
CSV_DATA_DIR=./data/csv
SAMPLE_DATA_DIR=./data/sample
