# Application
APP_NAME=RealSearch
DEBUG=False

# Backend only. Do not expose these values to frontend builds.
ADMIN_PASSWORD=change_me_to_strong_admin_password
DATABASE_URL=postgresql://user:password@host:port/dbname
VWORLD_API_KEY=your_vworld_api_key

# Backend server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=https://realsearch.kr,https://www.realsearch.kr

# Frontend public variables. NEXT_PUBLIC_* values are visible in the browser.
NEXT_PUBLIC_SITE_URL=https://realsearch.kr
NEXT_PUBLIC_API_URL=https://realsearch.kr
INTERNAL_API_URL=http://localhost:8000

# Data paths
DATA_FETCH_INTERVAL_HOURS=24
CSV_DATA_DIR=./data/csv
SAMPLE_DATA_DIR=./data/sample
